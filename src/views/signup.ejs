<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST" enctype="multipart/form-data">
      <div class="signup-frame" style="width: 650px">
        <div class="signup-top">
          <span>회원 가입</span>
          <div>뒤로 가기 <a href="/admin" style="color: #6440fb">홈</a></div>
          <p>
            이미 가입하셨나요?
            <a href="/admin/login" style="color: #6440fb">로그인</a>
          </p>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>관리자 *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="사용자 이름"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>전화번호 *</label>
            <input
              type="text"
              name="memberPhone"
              class="member-phone"
              placeholder="전화번호"
              value=""
            />
          </div>
        </div>
        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>비밀번호 *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="비밀번호"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>비밀번호 확인 *</label>
            <input
              type="password"
              name="confirmPassword"
              class="confirm-password"
              placeholder="비밀번호 확인"
              value=""
            />
          </div>
        </div>

        <div class="signup-input-frame">
          <div class="media-frame">
            <img class="upload-img-frame" src="/img/favicon.png" />
            <div class="upload-container">
              <span class="media-text">프로필 이미지</span>
              <div
                class="file-box bs3-primary preview-image"
                style="margin-top: 25px; display: flex"
              >
                <input
                  class="upload-name"
                  value="이미지 선택"
                  disabled="disabled"
                />
                <label for="input-file" class="file-input-label"
                  >이미지 업로드</label
                >
                <input
                  type="file"
                  id="input-file"
                  class="upload-hidden form-control-file member-image"
                  name="memberImage"
                />
              </div>
              <p class="thumbnail-desc">
                업로드할 레스토랑 이미지를 선택하세요.<br />
                허용되는 형식: .jpg, .jpeg, .png <br />
                주의해주세요!
              </p>
            </div>
          </div>
        </div>

        <input name="memberType" value="BOOK" hidden />

        <button class="signup-btn btn" name="signup" type="submit">
          회원 가입
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>

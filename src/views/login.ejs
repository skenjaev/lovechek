<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <form class="login-container" action="/admin/login" METHOD="POST">
    <div class="login-frame">
      <div class="login-top">
        <span>회원가입</span>
        <div>돌아가기<a href="/admin" style="color: #6440fb">홈</a></div>
        <p>
          이미 가입하셨나요?
          <a href="/admin/signup" style="color: #6440fb">가입</a>
        </p>
      </div>
      <div class="login-input-frame">
        <div class="login-input-container">
          <label>관리자</label>
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="사용자 이름"
            value=""
            required
          />
        </div>
        <div class="login-input-container">
          <label>비밀번호</label>
          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="비밀번호"
            value=""
            required
          />
        </div>
      </div>
      <button class="login-btn btn" name="login" type="submit">로그인</button>
    </div>
  </form>
</body>

<%- include('includes/footer') %>

<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin/">홈</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">메뉴</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all">사용자</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">로그아웃</a>
        </li>
      </ul>
    </div>

    <div class="book-menu-frame">
      <div class="board">
        <div class="books-table">
          <span class="new-book-txt" style="margin-bottom: 30px">
            책 목록
          </span>
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">#</th>
                <th scope="col">책명</th>
                <th scope="col">종류</th>
                <th scope="col">지역</th>
                <th scope="col">가격</th>
                <th scope="col">할인율</th>
                <th scope="col">상태</th>
              </tr>
            </thead>

           <% products.map(function(value, key) { %>
            <tbody style="background: white">
              <td><%= key + 1 %></td>
              <td><%= value.productName %></td>
              <td><%= value.productCollection %></td>
              <td><%= value.region %></td>
              <td><%= value.productPrice %></td>
              <td><%= value.discountPercent %></td>
              <td>
                <select class="spec-select new-product-status" id="<%= value._id %>">
                  <option value="진행 중"<%= value.productStatus === '진행 중' ? 'selected' : '' %> >진행 중</option>
                  <option value="정지" <%= value.productStatus === '정지' ? 'selected' : '' %> >정지</option>
                  <option value="삭제" <%= value.productStatus === '삭제' ? 'selected' : '' %> >삭제</option>
                </select>
              </td>
            </tbody>
            <% }) %>
           
          </table>
          <div
            class="long-input"
            style="align-items: flex-end; margin-bottom: 25px"
          >
            <button class="btn btn-primary" id="process-btn">
              책 추가
            </button>
          </div>
        </div>
        <form 
        onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          class="book-container"
          enctype="multipart/form-data"
        >
          <div class="long-input" style="display: flex; align-items: center">
            <span class="new-book-txt">새로운 책 정보</span>
          </div>
          <div class="login-input-frame">
            <div class="long-input">
              <label>책 제목</label>
              <input
                type="text"
                placeholder="책 제목"
                name="productName"
                class="product-name"
              />
            </div>
            <input
              name="productStatus"
              value="진행 중"
              class="product-status"
              hidden
            />
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label>가격</label>
              <input
                type="number"
                placeholder="가격"
                name="productPrice"
                class="product-price"
              />
            </div>
            <div class="half-input">
              <label>할인율</label>
              <input
                type="number"
                placeholder="할인율"
                name="discountPercent"
                class="product-left-count"
              />
            </div>
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label>종류</label>
                <select class="product-collection" name="productCollection">
                  <option value="소설" selected>소설</option>
                  <option value="자기계발">자기계발</option>
                  <option value="만화">만화</option>
                  <option value="인문">인문</option>
                  <option value="과학">과학</option>
                  <option value="역사/문화">역사/문화</option>
                  <option value="어린이">어린이</option>
                  <option value="경제/경영">경제/경영</option>
                  <option value="잡지">잡지</option>
                  <option value="여행">여행</option>
                </select>
            </div>

            <div class="half-input" id="product-collection">
                <label>지역</label>
                <select class="region-filter" name="region">
                  <option value="국내" selected>국내</option>
                  <option value="서양">서양</option>
                  <option value="아시아">아시아</option>
                </select>
            </div>

          </div>
          <div class="long-input">
            <label>상품 설명</label>
            <textarea name="productDesc" class="product-desc"></textarea>
          </div>

          <div class="img-frame">
            <label>상품 이미지</label>
            <div class="media-frame">
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="1" id="image-section-1" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-one"
                  required
                  onchange="previewFileHandler(this, 1)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="2" id="image-section-2" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-two"
                  onchange="previewFileHandler(this, 2)"

                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="3" id="image-section-3" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-three"
                  onchange="previewFileHandler(this, 3)"

                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="4" id="image-section-4" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-four"
                  onchange="previewFileHandler(this, 4)"

                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="5" id="image-section-5" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-five"
                  onchange="previewFileHandler(this, 5)"

                />
              </div>
              <input name="book-id" class="book-id" hidden />
            </div>
          </div>

          <div class="operation-buttons">
            <button class="btn btn-danger" id="cancel-btn">취소</button>
            <button type="submit" class="btn btn-primary" id="create-btn">
              생성
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>

<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <div class="users-container">
    <% if (!member) { %>
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin/">홈</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/signup">가입</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/login">로그인</a>
        </li>
      </ul>
    </div>

    <div class="users-frame" style="color: #dddddd">
      <div class="board" style="font-size: 40px">먼저 로그인 해주세요!</div>
    </div>

    <% } else { %>
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin/">홈</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">메뉴</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all">사용자</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you really want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">로그아웃</a>
        </li>
      </ul>
    </div>

    <div class="users-frame">
      <div class="board">
        <div class="user-table">
          <span class="header-name" style="margin-bottom: 30px">
            모든 사용자 목록
          </span>
          <table class="table table-hover table-sm">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">번호</th>
                <th scope="col">이름</th>
                <th scope="col">전화번호</th>
                <th scope="col">상태</th>
              </tr>
            </thead>
            <% users.forEach(function(value, index) { %>
              <tbody style="background: white">
              <tr>
                <td><%= index + 1 %></td>
                <td><%= value.memberNick %></td>
                <td><%= value.memberPhone %></td>
                <td style="width: 13%">
                  <select class="spec-select member-status" id="<%= value._id %>">
                    <option value="ACTIVE" <%= value.memberStatus === 'ACTIVE' ? 'selected' : '' %> >활성</option>
                    <option value="BLOCK" <%= value.memberStatus === 'BLOCK' ? 'selected' : '' %> >차단</option>
                    <option value="DELETE" <%= value.memberStatus === 'DELETE' ? 'selected' : '' %> >삭제</option>
                  </select>
                </td>
              </tr>
            </tbody>
            <% }) %>
          </table>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>

